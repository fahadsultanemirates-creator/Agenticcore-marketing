# Required to run agents against the real Claude API.
# Without this set, examples fall back to an offline dry-run client.
ANTHROPIC_API_KEY=

# Optional: override the default model used by every agent.
AGENTICCORE_MODEL=claude-sonnet-5

# --- Publishing (Ayrshare) ---
# From your Ayrshare dashboard. Per-project Profile-Keys go in each
# brands/<slug>.json file instead, not here.
AYRSHARE_API_KEY=

# --- Approval (Telegram) ---
# From @BotFather. TELEGRAM_CHAT_ID is the default chat; a brand's JSON
# profile can override it with its own telegram_chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Creative tools (optional; leave blank to get text-only posts) ---
IDEOGRAM_API_KEY=
XAI_API_KEY=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
